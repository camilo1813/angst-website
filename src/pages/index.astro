---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

// Single public contact address for all contact / collaboration actions.
const contactEmail = 'info@angstdata.in';
const mailCollab = `mailto:${contactEmail}?subject=Collaboration%20with%20ANGST`;
const mailContact = `mailto:${contactEmail}`;
const year = new Date().getFullYear();

const principles = [
  { k: 'K', t: 'Knowledge', d: 'Context about people, machines and spaces that frames every observation.' },
  { k: 'U', t: 'Uncertainty', d: 'Explicit treatment of what an observation can and cannot support.' },
  { k: 'R', t: 'Reasoning', d: 'Relating observations to each other instead of scoring them in isolation.' },
  { k: 'T', t: 'Temporal', d: 'Events understood as sequences that unfold over time.' },
  { k: 'I', t: 'Intelligence', d: 'Structured understanding that supports human decisions.' },
  { k: 'Q', t: 'Qualification', d: 'Every conclusion carries the conditions under which it holds.' },
];

const applications = [
  { t: 'Industrial Intelligence & Assurance', d: 'Understanding interactions between workers, equipment and process conditions on industrial sites.', m: 'grid' },
  { t: 'Robotics & Autonomous Systems', d: 'Context for systems that share physical space with people and other machines.', m: 'arm' },
  { t: 'Perimeter & Critical Infrastructure Intelligence', d: 'Interpreting activity around sensitive assets as events, not isolated alerts.', m: 'perimeter' },
  { t: 'Mobility, Logistics & Transportation', d: 'Reasoning about movement, handling and interaction across moving operations.', m: 'route' },
  { t: 'Infrastructure & Public Safety', d: 'Situational understanding for shared spaces, structures and public environments.', m: 'structure' },
  { t: 'Environmental & Spatial Intelligence', d: 'Relating changing conditions in space and structure to their physical consequences.', m: 'terrain' },
];

const research = [
  'Spatial reconstruction',
  'Temporal reasoning',
  'Evidence uncertainty',
  'Sensor fusion',
  'Digital twins',
  'Physics-informed simulation',
  'Human-machine interaction',
  'Event reconstruction',
];

const collab = [
  { t: 'Industry', d: 'Operators with real physical-world safety questions.' },
  { t: 'Research institutions', d: 'Academic work on perception, reasoning and uncertainty.' },
  { t: 'Robotics & automation', d: 'Teams building systems that act in shared spaces.' },
  { t: 'Sensors & instrumentation', d: 'Measurement that can establish what vision alone cannot.' },
  { t: 'Simulation & digital twins', d: 'Environments for testing and validating reasoning.' },
  { t: 'Engineering validation', d: 'Independent methods for verifying physical outcomes.' },
];

// deterministic correlation matrix intensities (illustrative UI only)
const matrix = [
  [4, 1, 0, 2, 0],
  [1, 4, 2, 0, 1],
  [0, 2, 4, 3, 0],
  [2, 0, 3, 4, 1],
  [0, 1, 0, 1, 4],
];
---

<BaseLayout>
  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">ANGST</p>
          <h1 id="hero-title" class="display">
            Life. Machines. Environments.
            <span class="display__muted">One Safety Intelligence Layer.</span>
          </h1>
          <p class="lead">
            ANGST develops intelligence for understanding physical-world events across people, machines and
            environments — connecting observations, context and evidence rather than treating them as isolated
            signals.
          </p>
          <div class="actions">
            <a class="btn btn--dark" href="#kurtiq">Explore KURTIQ</a>
            <a class="btn btn--line" href="#collaborate">Collaborate with ANGST</a>
          </div>
        </div>

        <figure class="console" aria-label="Illustrative interface: physical event analysis across a person, a machine and an environment zone">
          <div class="console__bar" aria-hidden="true">
            <span class="console__title"><i class="dot"></i>Physical event</span>
            <span class="console__meta"><em>Event ID</em> EV-0427</span>
            <span class="console__meta console__meta--opt"><em>Window</em> 00:00:14.2</span>
            <span class="pill">Under review</span>
          </div>

          <div class="console__field" aria-hidden="true">
            <svg viewBox="0 0 720 440" focusable="false">
              <defs>
                <pattern id="hg-s" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M20 0H0V20" fill="none" stroke="#EEEEEB" stroke-width="1" />
                </pattern>
                <pattern id="hg-l" width="100" height="100" patternUnits="userSpaceOnUse">
                  <rect width="100" height="100" fill="url(#hg-s)" />
                  <path d="M100 0H0V100" fill="none" stroke="#E2E2DE" stroke-width="1" />
                </pattern>
                <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <path d="M0 0V7" stroke="#CFCFCA" stroke-width="1.2" />
                </pattern>
              </defs>

              <rect width="720" height="440" fill="#FFFFFF" />
              <rect x="40" y="20" width="660" height="400" fill="url(#hg-l)" />

              <!-- axis ticks -->
              <g stroke="#B9B9B4" stroke-width="1">
                <path d="M40 20V420M40 420H700" />
                <path d="M140 420v6M240 420v6M340 420v6M440 420v6M540 420v6M640 420v6" />
                <path d="M34 120h6M34 220h6M34 320h6" />
              </g>
              <g class="svg-lbl svg-lbl--fine" fill="#9A9A95">
                <text x="140" y="438" text-anchor="middle">2.0</text>
                <text x="340" y="438" text-anchor="middle">6.0</text>
                <text x="540" y="438" text-anchor="middle">10.0 m</text>
                <text x="28" y="224" text-anchor="end">4.0</text>
              </g>

              <!-- ENVIRONMENT: zone footprint + restricted region -->
              <path d="M80 60 H560 V170 H660 V390 H80 Z" fill="#FAFAF8" stroke="#1A1A1A" stroke-width="1.4" />
              <path d="M440 250 H660 V390 H440 Z" fill="url(#hatch)" stroke="#8D8D88" stroke-width="1" />
              <path d="M80 300 H300" stroke="#8D8D88" stroke-width="1" stroke-dasharray="6 5" />

              <!-- camera viewpoint -->
              <g>
                <path d="M84 64 L330 205 L250 300 Z" fill="#050505" fill-opacity="0.035" stroke="#B9B9B4" stroke-width="1" stroke-dasharray="3 4" />
                <rect x="78" y="58" width="14" height="14" fill="#050505" />
              </g>

              <!-- MACHINE: footprint + operating envelope -->
              <g>
                <path d="M520 205 m-118 0 a118 118 0 0 1 118 -118" fill="none" stroke="#8D8D88" stroke-width="1" stroke-dasharray="2 5" />
                <circle cx="520" cy="205" r="118" fill="none" stroke="#E2E2DE" stroke-width="1" />
                <rect x="490" y="175" width="60" height="60" fill="#FFFFFF" stroke="#050505" stroke-width="1.6" />
                <rect x="508" y="193" width="24" height="24" fill="#050505" />
                <path d="M520 205 L438 148" stroke="#050505" stroke-width="3" stroke-linecap="square" />
                <rect x="430" y="140" width="14" height="14" fill="#FFFFFF" stroke="#050505" stroke-width="1.6" />
              </g>

              <!-- LIFE: trajectory (temporal positions) + current position -->
              <g>
                <path class="trail" d="M160 360 C 200 330, 230 300, 270 280 S 340 236, 370 214" fill="none" stroke="#8D8D88" stroke-width="1.2" stroke-dasharray="1 6" stroke-linecap="round" />
                <g fill="#FFFFFF" stroke="#8D8D88" stroke-width="1.2">
                  <circle cx="160" cy="360" r="3.5" />
                  <circle cx="214" cy="318" r="3.5" />
                  <circle cx="270" cy="280" r="3.5" />
                  <circle cx="324" cy="246" r="3.5" />
                </g>
                <path d="M370 214 L404 178 A48 48 0 0 1 418 214 Z" fill="#050505" fill-opacity="0.08" />
                <circle cx="370" cy="214" r="9" fill="#050505" />
                <circle cx="370" cy="214" r="17" fill="none" stroke="#050505" stroke-width="1" />
              </g>

              <!-- relationship: proximity line person ↔ machine -->
              <path d="M387 210 L432 158" stroke="#050505" stroke-width="1" />
              <g class="svg-lbl" fill="#050505">
                <text x="414" y="196">0.9 m</text>
              </g>

              <!-- EVENT BOUNDARY -->
              <g fill="none" stroke="#050505" stroke-width="1.6">
                <path d="M310 118 h-16 v16" />
                <path d="M470 118 h16 v16" />
                <path d="M310 272 h-16 v-16" />
                <path d="M470 272 h16 v-16" />
              </g>
              <rect x="294" y="118" width="192" height="154" fill="none" stroke="#050505" stroke-width="1" stroke-dasharray="4 4" />
              <g class="svg-lbl"><rect x="294" y="94" width="118" height="24" fill="#050505" />
              <text class="svg-tag" x="302" y="111" fill="#FFFFFF">EVENT · E-01</text></g>

              <!-- observation markers -->
              <g stroke="#050505" stroke-width="1.2" fill="none">
                <g transform="translate(214 318)"><path d="M-9 0h-5M9 0h5M0 -9v-5M0 9v5" /><circle r="6" /></g>
                <g transform="translate(560 300)"><path d="M-9 0h-5M9 0h5M0 -9v-5M0 9v5" /><circle r="6" /></g>
                <g transform="translate(324 246)"><path d="M-9 0h-5M9 0h5M0 -9v-5M0 9v5" /><circle r="6" /></g>
              </g>
              <g class="svg-lbl" fill="#050505">
                <text x="226" y="336">O1</text>
                <text x="572" y="318">O2</text>
                <text x="336" y="266">O3</text>
              </g>

              <!-- entity labels (hidden on small screens; legend below carries them) -->
              <g class="svg-lbl svg-lbl--key">
                <rect x="96" y="72" width="150" height="26" fill="#FFFFFF" stroke="#E2E2DE" />
                <text x="105" y="90" fill="#1A1A1A">ENV · ZONE B</text>
                <rect x="548" y="118" width="160" height="26" fill="#FFFFFF" stroke="#E2E2DE" />
                <text x="557" y="136" fill="#1A1A1A">MACHINE · M-01</text>
                <rect x="96" y="378" width="130" height="26" fill="#FFFFFF" stroke="#E2E2DE" />
                <text x="105" y="396" fill="#1A1A1A">LIFE · L-02</text>
              </g>
            </svg>
          </div>

          <ul class="console__legend" aria-hidden="true">
            <li><i class="lg lg--life"></i>Life</li>
            <li><i class="lg lg--machine"></i>Machine</li>
            <li><i class="lg lg--env"></i>Environment</li>
            <li><i class="lg lg--event"></i>Event boundary</li>
            <li class="console__illus">Illustrative</li>
          </ul>

          <dl class="console__foot" aria-hidden="true">
            <div><dt>Observations</dt><dd>3 linked</dd></div>
            <div><dt>Context</dt><dd>Zone B · M-01 active</dd></div>
            <div class="opt"><dt>Evidence state</dt><dd>Partial</dd></div>
            <div class="opt"><dt>Temporal state</dt><dd>Sequence open</dd></div>
          </dl>
        </figure>
      </div>
    </section>

    <!-- ============ PROPOSITION + DOMAIN MODULES ============ -->
    <section class="section" aria-labelledby="stmt-title">
      <div class="wrap">
        <div class="statement">
          <h2 id="stmt-title" class="h-xl">Reality does not happen in isolated alerts.</h2>
          <p class="lead">
            Physical events unfold through relationships between people, machines, spaces, time and evidence.
            Understanding the event requires more than detecting individual objects or signals.
          </p>
        </div>

        <ul class="modules" role="list">
          <!-- LIFE -->
          <li class="module">
            <div class="panel" aria-hidden="true">
              <div class="panel__head"><span>Entity · L-02</span><span class="pill pill--sm">Present</span></div>
              <svg class="panel__viz" viewBox="0 0 300 96" focusable="false">
                <path d="M0 72 H300" stroke="#E6E6E3" />
                <path d="M0 48 H300" stroke="#F0F0ED" />
                <rect x="150" y="30" width="110" height="36" fill="#050505" fill-opacity="0.05" />
                <path d="M150 30 V66 M260 30 V66" stroke="#B9B9B4" stroke-dasharray="2 3" />
                <path d="M12 70 C 60 68, 90 60, 130 52 S 210 40, 286 38" fill="none" stroke="#1A1A1A" stroke-width="1.4" />
                <g fill="#FFFFFF" stroke="#1A1A1A" stroke-width="1.2">
                  <circle cx="12" cy="70" r="3" /><circle cx="76" cy="64" r="3" /><circle cx="130" cy="52" r="3" />
                  <circle cx="196" cy="44" r="3" />
                </g>
                <circle cx="286" cy="38" r="5" fill="#050505" />
                <g class="svg-mini" fill="#8D8D88"><text x="154" y="24">PROXIMITY WINDOW</text><text x="2" y="90">t−12s</text><text x="272" y="90">t0</text></g>
              </svg>
              <dl class="panel__kv">
                <div><dt>Interaction</dt><dd>Near M-01</dd></div>
                <div><dt>Dwell</dt><dd>00:08.4</dd></div>
              </dl>
            </div>
            <span class="card__num">01</span>
            <h3 class="module__title">Life</h3>
            <p>Human presence, behaviour and interaction.</p>
          </li>

          <!-- MACHINE -->
          <li class="module">
            <div class="panel" aria-hidden="true">
              <div class="panel__head"><span>Asset · M-01</span><span class="pill pill--sm pill--dark">Active</span></div>
              <svg class="panel__viz" viewBox="0 0 300 96" focusable="false">
                <g class="svg-mini" fill="#8D8D88"><text x="0" y="22">RUN</text><text x="0" y="46">HOLD</text><text x="0" y="70">IDLE</text></g>
                <path d="M40 18H300M40 42H300M40 66H300" stroke="#F0F0ED" />
                <path d="M40 66 H78 V18 H150 V42 H186 V18 H244 V42 H300" fill="none" stroke="#050505" stroke-width="1.6" />
                <path d="M186 6 V80" stroke="#050505" stroke-dasharray="2 3" />
                <rect x="180" y="80" width="12" height="12" fill="#050505" />
                <g class="svg-mini" fill="#8D8D88"><text x="198" y="90">STATE CHANGE</text></g>
              </svg>
              <dl class="panel__kv">
                <div><dt>Operating state</dt><dd>Cycle</dd></div>
                <div><dt>Signal</dt><dd>Transition</dd></div>
              </dl>
            </div>
            <span class="card__num">02</span>
            <h3 class="module__title">Machines</h3>
            <p>State, operation and physical behaviour.</p>
          </li>

          <!-- ENVIRONMENT -->
          <li class="module">
            <div class="panel" aria-hidden="true">
              <div class="panel__head"><span>Zone · B</span><span class="pill pill--sm">Bounded</span></div>
              <svg class="panel__viz" viewBox="0 0 300 96" focusable="false">
                <defs>
                  <pattern id="mh" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V6" stroke="#D2D2CD" stroke-width="1.2" /></pattern>
                </defs>
                <path d="M30 10 H220 V40 H270 V86 H30 Z" fill="#FAFAF8" stroke="#1A1A1A" stroke-width="1.4" />
                <path d="M190 54 H270 V86 H190 Z" fill="url(#mh)" stroke="#8D8D88" />
                <path d="M30 60 H130" stroke="#8D8D88" stroke-dasharray="4 4" />
                <g stroke="#B9B9B4"><path d="M30 4 V8 M220 4 V8 M30 6 H220" /></g>
                <rect x="96" y="28" width="8" height="8" fill="#050505" />
                <g class="svg-mini" fill="#8D8D88"><text x="198" y="48">RESTRICTED</text></g>
              </svg>
              <dl class="panel__kv">
                <div><dt>Boundary</dt><dd>Defined</dd></div>
                <div><dt>Condition</dt><dd>Variable light</dd></div>
              </dl>
            </div>
            <span class="card__num">03</span>
            <h3 class="module__title">Environments</h3>
            <p>Space, structure, context and changing conditions.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============ KURTIQ ============ -->
    <section class="section section--dark" id="kurtiq" aria-labelledby="kurtiq-title">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow eyebrow--inv">KURTIQ</p>
            <h2 id="kurtiq-title" class="h-xl">Question Every Conclusion.</h2>
          </div>
          <div class="split__side">
            <p class="lead lead--inv">
              KURTIQ is ANGST's intelligence platform for reasoning across observations, uncertainty, time and
              physical context.
            </p>
            <p class="kicker">Intelligence That Questions Its Own Conclusions.</p>
          </div>
        </div>

        <!-- Why KURTIQ: intellectual origin -->
        <article class="origin" aria-labelledby="why-title">
          <div class="origin__head">
            <p class="eyebrow eyebrow--inv">Why KURTIQ?</p>
            <h3 id="why-title" class="h-md">Inspired by Kurt Gödel.</h3>
          </div>
          <figure class="origin__fig">
            <!--
              Source: Wikimedia Commons, "File:Kurt Gödel.png" (1920 × 2631 PNG, dated 1970-02-10),
              listed there under CC BY 4.0. Modifications for ANGST: cropped to 4:5 and converted to WebP.
              No tonal, retouching or generative edits (source is already monochrome).
            -->
            <img
              src="/images/kurt-goedel.webp"
              srcset="/images/kurt-goedel-640.webp 640w, /images/kurt-goedel.webp 1120w"
              sizes="(max-width: 720px) 112px, 240px"
              width="1120"
              height="1400"
              alt="Kurt Gödel"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              Kurt Gödel, 1970. Source:
              <a href="https://commons.wikimedia.org/wiki/File:Kurt_G%C3%B6del.png" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.
              <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer license" class="nowrap">CC BY 4.0</a>.
              Cropped and converted to WebP for ANGST.
            </figcaption>
          </figure>
          <div class="origin__body">
            <p class="origin__lead">
              KURTIQ takes its name from a tradition of rigorous questioning. It applies that discipline to
              physical-world intelligence.
            </p>
            <ol class="origin__qs" role="list">
              <li><span>Q1</span>What can a system establish?</li>
              <li><span>Q2</span>What remains uncertain?</li>
              <li><span>Q3</span>Where are the limits of a conclusion?</li>
            </ol>
            <p class="note note--inv">
              <span>NOTE /</span> The inspiration is methodological and philosophical. KURTIQ does not claim to
              implement Gödel's incompleteness theorems.
            </p>
          </div>
        </article>

        <!-- Principles: hub architecture (non-linear) -->
        <div class="arch" aria-labelledby="arch-title">
          <h3 id="arch-title" class="arch__label">KURTIQ principles</h3>
          <ul class="arch__mods arch__mods--top" role="list">
            {principles.slice(0, 3).map((p) => (
              <li class="amod">
                <span class="amod__key">{p.k}</span>
                <h4>{p.t}</h4>
                <p>{p.d}</p>
              </li>
            ))}
          </ul>
          <div class="arch__core">
            <span class="arch__ports" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="arch__core-body">
              <span class="arch__core-tag">Core</span>
              <strong>Event / Evidence Model</strong>
              <span class="arch__core-sub">Every principle reads from and writes to one shared model of the event.</span>
            </div>
            <span class="arch__ports arch__ports--b" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <ul class="arch__mods arch__mods--bottom" role="list">
            {principles.slice(3).map((p) => (
              <li class="amod">
                <span class="amod__key">{p.k}</span>
                <h4>{p.t}</h4>
                <p>{p.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ LIFECYCLE ============ -->
    <section class="section" id="lifecycle" aria-labelledby="life-title">
      <div class="wrap">
        <div class="statement">
          <p class="eyebrow">How it reasons</p>
          <h2 id="life-title" class="h-xl">From observation to understanding.</h2>
        </div>

        <ol class="flow" role="list">
          <li class="step">
            <span class="step__num">01</span>
            <div class="step__txt"><h3>Sense</h3><p>Capture observations from cameras, sensors and operational systems.</p></div>
            <div class="frag" aria-hidden="true">
              <div class="frag__head"><span>Inputs</span><span>4 streams</span></div>
              <ul class="frag__stack">
                <li><b>CAM-01</b><i class="bars" style="--v:.82"></i><em>live</em></li>
                <li><b>CAM-03</b><i class="bars" style="--v:.64"></i><em>live</em></li>
                <li><b>IO-07</b><i class="bars" style="--v:.38"></i><em>state</em></li>
                <li><b>ENV-02</b><i class="bars" style="--v:.52"></i><em>cond.</em></li>
              </ul>
            </div>
          </li>

          <li class="step">
            <span class="step__num">02</span>
            <div class="step__txt"><h3>Correlate</h3><p>Relate signals across people, machines, spaces and time.</p></div>
            <div class="frag" aria-hidden="true">
              <div class="frag__head"><span>Relation matrix</span><span>5 × 5</span></div>
              <div class="matrix">
                {matrix.flat().map((v) => <i class={`m${v}`}></i>)}
              </div>
            </div>
          </li>

          <li class="step">
            <span class="step__num">03</span>
            <div class="step__txt"><h3>Understand</h3><p>Form a qualified interpretation of what is taking place.</p></div>
            <div class="frag" aria-hidden="true">
              <div class="frag__head"><span>Event state</span><span>Synthesis</span></div>
              <svg class="frag__svg" viewBox="0 0 280 84" focusable="false">
                <g class="svg-mini" fill="#8D8D88"><text x="0" y="16">LIFE</text><text x="0" y="46">MACHINE</text><text x="0" y="76">ZONE</text></g>
                <path d="M62 12 C 120 12, 120 42, 168 42 M62 42 H168 M62 72 C 120 72, 120 42, 168 42" fill="none" stroke="#8D8D88" />
                <rect x="168" y="26" width="112" height="32" fill="#050505" />
                <text class="svg-mini" x="180" y="46" fill="#FFFFFF">INTERACTION</text>
              </svg>
            </div>
          </li>

          <li class="step">
            <span class="step__num">04</span>
            <div class="step__txt"><h3>Respond</h3><p>Support people with context they can act on with confidence.</p></div>
            <div class="frag" aria-hidden="true">
              <div class="frag__head"><span>Action queue</span><span>Human review</span></div>
              <ul class="frag__list">
                <li><b class="tag tag--dark">P1</b>Review event E-01<em>Open</em></li>
                <li><b class="tag">P2</b>Notify zone owner<em>Queued</em></li>
                <li><b class="tag">P3</b>Attach evidence<em>Queued</em></li>
              </ul>
            </div>
          </li>

          <li class="step">
            <span class="step__num">05</span>
            <div class="step__txt"><h3>Reconstruct</h3><p>Rebuild how an event unfolded from the available evidence.</p></div>
            <div class="frag" aria-hidden="true">
              <div class="frag__head"><span>Replay</span><span>t−14s → t0</span></div>
              <svg class="frag__svg" viewBox="0 0 280 84" focusable="false">
                <g class="svg-mini" fill="#8D8D88"><text x="0" y="18">L-02</text><text x="0" y="44">M-01</text><text x="0" y="70">OBS</text></g>
                <path d="M44 14H280M44 40H280M44 66H280" stroke="#EEEEEB" />
                <rect x="60" y="10" width="150" height="8" fill="#B9B9B4" />
                <rect x="44" y="36" width="70" height="8" fill="#1A1A1A" /><rect x="140" y="36" width="120" height="8" fill="#1A1A1A" />
                <g fill="#050505"><rect x="90" y="62" width="8" height="8" /><rect x="160" y="62" width="8" height="8" /><rect x="214" y="62" width="8" height="8" /></g>
                <path d="M200 2 V82" stroke="#050505" stroke-width="1.4" />
                <path d="M195 2 h10 l-5 6 z" fill="#050505" />
              </svg>
            </div>
          </li>

          <li class="step">
            <span class="step__num">06</span>
            <div class="step__txt"><h3>Learn</h3><p>Feed what was established back into future understanding.</p></div>
            <div class="frag" aria-hidden="true">
              <div class="frag__head"><span>Evidence model</span><span>Revision</span></div>
              <dl class="frag__delta">
                <div><dt>Context priors</dt><dd><i style="--a:.42;--b:.58"></i></dd></div>
                <div><dt>Uncertainty bounds</dt><dd><i style="--a:.66;--b:.54"></i></dd></div>
                <div><dt>Event patterns</dt><dd><i style="--a:.30;--b:.46"></i></dd></div>
              </dl>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ KURTIQ VISION ============ -->
    <section class="section section--soft" id="vision" aria-labelledby="vision-title">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="lockup">
              <span class="lockup__name">KURTIQ Vision</span>
              <span class="lockup__by">by ANGST</span>
            </p>
            <h2 id="vision-title" class="h-xl">Beyond What Machines See.</h2>
          </div>
          <div class="split__side">
            <p class="lead">
              KURTIQ Vision is being developed around a simple principle: seeing an event is not the same as
              proving what happened.
            </p>
          </div>
        </div>

        <div class="vpanel">
          <div class="vframe" aria-hidden="true">
            <div class="vframe__bar"><span><i class="dot"></i>CAM-03</span><span>Frame 01842</span></div>
            <svg viewBox="0 0 480 320" focusable="false">
              <rect width="480" height="320" fill="#1A1A1A" />
              <!-- surface in perspective -->
              <path d="M40 300 L150 70 H400 L460 300 Z" fill="#262626" stroke="#3A3A3A" />
              <g stroke="#333333">
                <path d="M95 185 H430" /><path d="M122 128 H415" /><path d="M68 243 H445" />
                <path d="M210 70 L180 300" /><path d="M275 70 L270 300" /><path d="M340 70 L360 300" />
              </g>
              <!-- seam + applied material strip -->
              <path d="M128 230 L372 150" stroke="#8D8D88" stroke-width="2" />
              <path d="M132 241 L380 160 L372 140 L124 221 Z" fill="#E6E6E3" fill-opacity="0.92" />
              <!-- bounding region -->
              <g fill="none" stroke="#FFFFFF" stroke-width="2">
                <path d="M110 120 h-14 v14" /><path d="M396 120 h14 v14" />
                <path d="M110 262 h-14 v-14" /><path d="M396 262 h14 v-14" />
              </g>
              <rect x="96" y="120" width="314" height="142" fill="none" stroke="#FFFFFF" stroke-dasharray="4 5" stroke-opacity="0.6" />
              <rect x="96" y="94" width="116" height="26" fill="#FFFFFF" />
              <text class="svg-tag svg-tag--lg" x="104" y="112" fill="#050505">REGION R-1</text>
              <!-- crosshair -->
              <g stroke="#FFFFFF" stroke-opacity="0.75"><path d="M240 20 V40 M240 300 V280 M20 160 H40 M460 160 H440" /></g>
              <!-- unresolved marker -->
              <g transform="translate(300 182)"><circle r="12" fill="none" stroke="#FFFFFF" stroke-dasharray="3 3" /><circle r="2.5" fill="#FFFFFF" /></g>
            </svg>
            <div class="vframe__bar vframe__bar--b"><span>View · oblique</span><span>Object · applied material</span></div>
          </div>

          <ol class="vsteps" role="list">
            <li class="vstep">
              <div class="vstep__head"><span class="vstep__n">01</span><h3>Observe</h3><span class="state state--full">Observed</span></div>
              <p>What visual systems can directly detect.</p>
              <p class="vstep__ex">Material is present along the seam within region R-1.</p>
            </li>
            <li class="vstep">
              <div class="vstep__head"><span class="vstep__n">02</span><h3>Question</h3><span class="state state--half">Not established</span></div>
              <p>What those observations actually establish.</p>
              <p class="vstep__ex">Placement is visible. Whether the joint is mechanically sound is not.</p>
            </li>
            <li class="vstep">
              <div class="vstep__head"><span class="vstep__n">03</span><h3>Qualify</h3><span class="state state--open">Measurement required</span></div>
              <p>What still requires independent evidence or measurement.</p>
              <p class="vstep__ex">Hidden properties such as bond quality need a separate test.</p>
            </li>
          </ol>
        </div>

        <p class="note">
          <span>NOTE /</span> Conceptual technology direction. Public website descriptions do not represent claims of
          validated real-time deployment unless explicitly stated.
        </p>
      </div>
    </section>

    <!-- ============ APPLICATIONS ============ -->
    <section class="section" id="applications" aria-labelledby="apps-title">
      <div class="wrap">
        <div class="statement">
          <p class="eyebrow">Applications</p>
          <h2 id="apps-title" class="h-xl">One intelligence layer.<br />Different physical worlds.</h2>
        </div>
        <ul class="apps" role="list">
          {applications.map((a, i) => (
            <li class={`app ${i % 2 === 0 ? 'app--white' : 'app--grey'}`}>
              <div class="app__top">
                <span class="app__num">{String(i + 1).padStart(2, '0')}</span>
                <svg class="motif" viewBox="0 0 120 56" aria-hidden="true" focusable="false">
                  {a.m === 'grid' && (
                    <g fill="none" stroke="#8D8D88">
                      <path d="M4 4H116V52H4Z" stroke="#1A1A1A" />
                      <path d="M32 4V52M60 4V52M88 4V52M4 20H116M4 36H116" stroke="#D2D2CD" />
                      <path d="M38 26l5 5 9-10" stroke="#050505" stroke-width="1.6" />
                      <path d="M94 42l5 5 9-10" stroke="#050505" stroke-width="1.6" />
                      <rect x="62" y="22" width="24" height="12" fill="#050505" stroke="none" />
                    </g>
                  )}
                  {a.m === 'arm' && (
                    <g fill="none" stroke="#1A1A1A">
                      <path d="M20 52 A40 40 0 0 1 100 52" stroke="#D2D2CD" stroke-dasharray="2 4" />
                      <rect x="50" y="40" width="20" height="12" fill="#050505" />
                      <path d="M60 40 L48 22 L78 12" stroke-width="2" />
                      <circle cx="48" cy="22" r="3" fill="#FFFFFF" />
                      <path d="M8 30 C 30 26, 80 34, 112 24" stroke="#8D8D88" stroke-dasharray="1 4" />
                    </g>
                  )}
                  {a.m === 'perimeter' && (
                    <g fill="none" stroke="#1A1A1A">
                      <path d="M10 10 L104 6 L114 46 L22 50 Z" stroke-dasharray="5 4" />
                      <rect x="48" y="20" width="22" height="16" fill="#050505" />
                      <g fill="#FFFFFF"><circle cx="10" cy="10" r="3" /><circle cx="104" cy="6" r="3" /><circle cx="114" cy="46" r="3" /><circle cx="22" cy="50" r="3" /></g>
                      <circle cx="96" cy="30" r="4" fill="#050505" stroke="none" />
                    </g>
                  )}
                  {a.m === 'route' && (
                    <g fill="none" stroke="#1A1A1A">
                      <path d="M6 46 H40 V18 H78 V38 H114" stroke-width="1.6" />
                      <path d="M6 52 H114" stroke="#D2D2CD" />
                      <g fill="#FFFFFF"><rect x="36" y="14" width="8" height="8" /><rect x="74" y="34" width="8" height="8" /></g>
                      <rect x="54" y="14" width="10" height="8" fill="#050505" stroke="none" />
                    </g>
                  )}
                  {a.m === 'structure' && (
                    <g fill="none" stroke="#1A1A1A">
                      <path d="M10 52 V18 L40 6 L70 18 V52" />
                      <path d="M10 30 H70 M10 42 H70 M30 52 V30 M50 52 V30" stroke="#D2D2CD" />
                      <path d="M82 52 V24 H112 V52" />
                      <path d="M4 52 H116" />
                      <rect x="56" y="34" width="8" height="8" fill="#050505" stroke="none" />
                    </g>
                  )}
                  {a.m === 'terrain' && (
                    <g fill="none" stroke="#8D8D88">
                      <path d="M4 44 C 24 34, 40 48, 60 38 S 96 28, 116 36" stroke="#1A1A1A" />
                      <path d="M4 34 C 26 22, 42 36, 62 26 S 96 16, 116 22" />
                      <path d="M4 24 C 28 12, 44 24, 64 14 S 96 6, 116 10" stroke="#D2D2CD" />
                      <path d="M70 4 V52" stroke="#1A1A1A" stroke-dasharray="2 3" />
                      <rect x="66" y="34" width="8" height="8" fill="#050505" stroke="none" />
                    </g>
                  )}
                </svg>
              </div>
              <h3 class="app__title">{a.t}</h3>
              <p>{a.d}</p>
            </li>
          ))}
        </ul>
        <p class="note"><span>NOTE /</span> Application areas describe engineering direction, not existing deployments.</p>
      </div>
    </section>

    <!-- ============ RESEARCH ============ -->
    <section class="section section--black" id="research" aria-labelledby="res-title">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow eyebrow--inv">Research areas</p>
            <h2 id="res-title" class="h-xl">Built for physical-world reasoning.</h2>
          </div>
          <div class="split__side">
            <p class="lead lead--inv">
              Our engineering direction combines perception with spatial, temporal and physical models. The areas
              below are research areas and capabilities under development — not deployed products.
            </p>
          </div>
        </div>
        <ul class="rgrid" role="list">
          {research.map((r, i) => (
            <li>
              <span class="rgrid__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="rgrid__t">{r}</span>
              <span class="rgrid__tag">Under development</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ COLLABORATE ============ -->
    <section class="section" id="collaborate" aria-labelledby="collab-title">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow">Collaborate</p>
            <h2 id="collab-title" class="h-xl">Complex physical-world intelligence is multidisciplinary.</h2>
          </div>
          <div class="split__side">
            <p class="lead">
              ANGST is interested in working with organisations across industry, research, robotics, sensing,
              simulation, engineering validation and applied safety intelligence.
            </p>
            <div class="actions">
              <a class="btn btn--dark" href={mailCollab}>Collaborate with ANGST</a>
              <a class="mail-link" href={mailContact}>{contactEmail}</a>
            </div>
          </div>
        </div>
        <ul class="clist" role="list">
          {collab.map((c, i) => (
            <li>
              <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ COMPANY ============ -->
    <section class="section section--soft" id="company" aria-labelledby="company-title">
      <div class="wrap split split--flush">
        <div>
          <p class="eyebrow">Company</p>
          <h2 id="company-title" class="h-lg">
            Life. Machines. Environments.<br />
            <span class="display__muted">One Safety Intelligence Layer.</span>
          </h2>
        </div>
        <div class="split__side">
          <p class="lead">
            ANGST is building towards intelligence systems that reason about physical events across people,
            machines and environments.
          </p>
          <p class="meta">ANGST Data Services India Pvt Ltd</p>
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section section--black cta" id="contact" aria-labelledby="cta-title">
      <div class="wrap">
        <h2 id="cta-title" class="display display--inv">When Reality Bites,<br />We Byte Back.</h2>
        <p class="lead lead--inv">Let's explore what physical-world intelligence can become.</p>
        <div class="actions">
          <a class="btn btn--light" href={mailCollab}>Collaborate with ANGST</a>
          <a class="btn btn--line-inv" href={mailContact}>Contact Us</a>
        </div>
        <p class="cta__mail"><a href={mailContact}>{contactEmail}</a></p>
      </div>
    </section>
  </main>

  <footer class="ftr">
    <div class="wrap ftr__inner">
      <a class="ftr__brand" href="#main">ANGST</a>
      <nav aria-label="Footer">
