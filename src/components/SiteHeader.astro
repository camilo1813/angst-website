---
const links = [
  { href: '#kurtiq', label: 'KURTIQ' },
  { href: '#vision', label: 'KURTIQ Vision' },
  { href: '#applications', label: 'Applications' },
  { href: '#research', label: 'Research' },
  { href: '#collaborate', label: 'Collaborate' },
  { href: '#company', label: 'Company' },
];
---

<header class="hdr" id="top">
  <div class="hdr__inner wrap">
    <a class="hdr__brand" href="#main" aria-label="ANGST — back to top">ANGST</a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="btn btn--dark btn--sm" href="#contact">Contact</a>
    </nav>

    <details class="mnav">
      <summary aria-controls="mnav-panel">
        <span class="mnav__icon" aria-hidden="true"></span>
        <span class="mnav__label mnav__label--open">Menu</span>
        <span class="mnav__label mnav__label--close">Close</span>
      </summary>
      <nav class="mnav__panel" id="mnav-panel" aria-label="Mobile">
        <ul>
          {links.map((l, i) => (
            <li>
              <a href={l.href}>
                <span class="mnav__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn--dark mnav__cta" href="#contact">Contact</a>
        <p class="mnav__mail"><a href="mailto:info@angstdata.in">info@angstdata.in</a></p>
      </nav>
    </details>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr');
  const menu = document.querySelector<HTMLDetailsElement>('.mnav');
  const summary = menu?.querySelector('summary');

  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const sync = () => {
    const open = !!menu?.open;
    document.documentElement.classList.toggle('menu-open', open);
    summary?.setAttribute('aria-expanded', String(open));
  };
  menu?.addEventListener('toggle', sync);
  sync();

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.open = false;
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      summary?.focus();
    }
  });
  // Close the overlay if the viewport grows past the mobile breakpoint.
  window.matchMedia('(min-width: 1081px)').addEventListener('change', (m) => {
    if (m.matches && menu) menu.open = false;
  });
</script>
