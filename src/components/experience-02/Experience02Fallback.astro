<div class="e02-fallback" aria-hidden="true">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="presentation" focusable="false">
    <!-- perspective floor grid -->
    <g stroke="#3a4046" stroke-width="1" opacity="0.35">
      <line x1="120" y1="820" x2="700" y2="560" />
      <line x1="420" y1="860" x2="820" y2="540" />
      <line x1="760" y1="880" x2="960" y2="520" />
      <line x1="1120" y1="860" x2="1080" y2="530" />
      <line x1="1420" y1="800" x2="1180" y2="550" />
      <line x1="120" y1="820" x2="1420" y2="800" />
      <line x1="300" y1="700" x2="1280" y2="690" />
      <line x1="500" y1="620" x2="1140" y2="615" />
    </g>

    <!-- diffuse environment field, right side -->
    <g fill="#9aa2a8" opacity="0.4">
      <circle cx="1180" cy="560" r="2" />
      <circle cx="1240" cy="600" r="1.6" />
      <circle cx="1300" cy="540" r="2.2" />
      <circle cx="1350" cy="620" r="1.4" />
      <circle cx="1420" cy="580" r="2" />
      <circle cx="1260" cy="500" r="1.5" />
      <circle cx="1380" cy="520" r="1.8" />
      <circle cx="1150" cy="640" r="1.6" />
      <circle cx="1440" cy="640" r="1.4" />
      <circle cx="1300" cy="470" r="1.3" />
    </g>

    <!-- rectilinear machine geometry -->
    <g stroke="#565c62" stroke-width="1.2" fill="none" opacity="0.55">
      <rect x="880" y="540" width="90" height="130" />
      <line x1="970" y1="540" x2="1030" y2="500" />
    </g>
    <g fill="#dfe3e6" opacity="0.5">
      <circle cx="900" cy="560" r="1.5" />
      <circle cx="955" cy="600" r="1.5" />
      <circle cx="920" cy="650" r="1.3" />
    </g>

    <!-- organic life cluster -->
    <g fill="#e9ebee" opacity="0.55">
      <circle cx="560" cy="600" r="1.6" />
      <circle cx="572" cy="580" r="1.4" />
      <circle cx="548" cy="565" r="1.5" />
      <circle cx="565" cy="545" r="1.3" />
      <circle cx="580" cy="620" r="1.6" />
      <circle cx="540" cy="610" r="1.4" />
      <circle cx="558" cy="525" r="1.2" />
      <circle cx="590" cy="590" r="1.3" />
      <circle cx="552" cy="640" r="1.5" />
      <circle cx="575" cy="505" r="1.1" />
    </g>

    <!-- signal origin, upper right -->
    <g>
      <line x1="1300" y1="230" x2="1400" y2="180" stroke="#8bcbff" stroke-width="1" opacity="0.12" />
      <circle cx="1300" cy="230" r="2.2" fill="#8bcbff" opacity="0.55" />
      <circle cx="1400" cy="180" r="1.6" fill="#8bcbff" opacity="0.18" />
    </g>
  </svg>
</div>
