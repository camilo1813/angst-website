---
// Shared story coordinator — P2A: PROGRESS SOURCE OF TRUTH · P3: owns the ONE persistent physical-world renderer.
// Renders no markup. E02/E03 consumers obtain their progress through lib/story/progressSource
// (coordinator by default; legacy per-section controllers as a temporary QA rollback).
// This script exposes the coordinator for QA and attaches the (reverse) comparator on request.
// Disable the coordinator entirely with PUBLIC_STORY_COORDINATOR=off (forces legacy progress).
// P3: renderer mode (lib/story/worldMode.ts) — 'persistent' (default): one persistent canvas renders
// E02 + E03; 'legacy' (?story-world=legacy rollback): the original two canvases, nothing persistent
// is loaded; 'shadow' (QA): legacy visible + hidden on-demand persistent world.
---

<script>
  import { getStoryCoordinator, STORY_COORDINATOR_VERSION } from '../lib/story/coordinator';
  import { attachShadowComparator } from '../lib/story/shadow';
  import { resolveProgressSource, progressConsumers } from '../lib/story/progressSource';
  import { resolveWorldMode } from '../lib/story/worldMode';

  const MODE = String(import.meta.env.PUBLIC_STORY_COORDINATOR ?? 'on');
  const w = window as unknown as Record<string, unknown>;

  // Everything is guarded: the coordinator must never be able to break the frozen experiences
  // (Astro bundles page scripts together).
  try {
    if (MODE !== 'off') {
      const coordinator = getStoryCoordinator();
      const debug = new URLSearchParams(window.location.search).has('story-debug');
      // Comparison runs in dev, with ?story-debug, or when QA tooling asks for it.
      const compare = import.meta.env.DEV || debug || w.__ANGST_STORY_QA__ === true;
      const shadow = compare ? attachShadowComparator(coordinator, { debugAttributes: debug }) : null;
      w.__angstStory = {
        version: STORY_COORDINATOR_VERSION,
        mode: MODE,
        progressSource: resolveProgressSource(),
        consumers: () => [...progressConsumers().values()].map((c) => ({ ...c, last: c.last && { ...c.last } })),
        getSnapshot: coordinator.getSnapshot,
        getDiagnostics: coordinator.getDiagnostics,
        subscribe: coordinator.subscribe,
        refresh: coordinator.refresh,
        shadow,
        worldMode: resolveWorldMode(),
        world: null,
      };
      const worldMode = resolveWorldMode();
      if (worldMode === 'persistent' || worldMode === 'shadow') {
        const story = w.__angstStory as Record<string, unknown>;
        story.worldMode = worldMode;
        import('./persistent-world/mountPersistentWorld')
          .then((m) => { story.world = m.mountPersistentWorld(coordinator, worldMode); })
          .catch((err) => { w.__angstStoryError = String(err); });
      }
    }
  } catch (err) {
    w.__angstStoryError = String(err);
  }
</script>
