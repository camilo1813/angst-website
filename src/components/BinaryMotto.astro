---
/**
 * ANGST motto — semantic intelligence animation.
 *
 * Each part of the motto has its own behaviour:
 *   When     → temporal: a 1px timeline t₀ → t₁ draws above the word
 *   Reality  → observation: measurement corners, grey (uncertain) letters, a faint "?"
 *   B·it·es  → BIT: "it" passes through 0/1 states (digital encoding of the event)
 *   We       → reasoning: two evidence points converge, "∴" appears briefly
 *   Byte     → BYTE: strongest binary transition + a brief 8-cell structure (8 bits = 1 byte)
 *   Back     → response: a faint echo converges into the word, underline returns right→left
 *   ™        → static, never animated
 *
 * Screen readers get one stable string; every visual layer is aria-hidden.
 * Without JavaScript, or with reduced motion, the motto is shown statically.
 */
interface Props {
  id?: string;
  class?: string;
  /** Render the ANGST wordmark above the motto as one brand lockup. */
  wordmark?: boolean;
}
const { id, class: className = '', wordmark = false } = Astro.props;
const motto = 'When Reality Bites, We Byte Back™';
const reality = 'Reality'.split('');
const octet = [0, 1, 0, 1, 1, 0, 0, 1];
---

<div class={wordmark ? 'blk' : 'blk blk--bare'} data-lockup>
{wordmark && <p class="blk__mark">ANGST</p>}
<h2 id={id} class={`motto ${className}`} data-motto>
  {wordmark && <span class="blk__drop" aria-hidden="true"></span>}
  <span class="motto__sr">{motto}</span>
  <span class="motto__vis" aria-hidden="true">
    <span class="mw mw--when">When<span class="m-tl"><i class="m-t0">t₀</i><i class="m-t1">t₁</i></span></span>
    <span class="mw mw--reality">{reality.map((c) => <span class="m-rc">{c}</span>)}<span class="m-obs"></span><i class="m-q">?</i></span>
    <span class="mw" data-bites>B<span class="motto__tok motto__tok--bit" data-tok="bit"
        ><span class="motto__ch">i</span><span class="motto__ch">t</span></span
      ><span data-after-bit>es,</span></span
    ><br />
    <span class="mw mw--we" data-before-byte>We<i class="m-cv m-cv--l"></i><i class="m-cv m-cv--r"></i><i class="m-th">∴</i></span>
    <span class="motto__tok motto__tok--byte" data-tok="byte"
      ><span class="motto__ch">B</span><span class="motto__ch">y</span><span class="motto__ch">t</span><span
        class="motto__ch">e</span
      ><span class="m-oct">{octet.map((b) => <i class={b ? 'on' : ''}></i>)}</span></span
    >
    <span class="mw mw--back" data-text="Back">Back</span><sup class="motto__tm">™</sup>
    <span class="motto__sig"></span>
  </span>
</h2>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  type Frame = (string | null)[];
  type Sig = { stop: boolean };

  const BIT_FRAMES: Frame[] = [['1', null], ['1', '0'], ['0', '1'], ['1', '0'], [null, '1']];
  const BYTE_FRAMES: Frame[] = [
    ['0', null, null, null],
    ['0', '1', null, null],
    [null, '1', '0', null],
    [null, null, '0', '1'],
    ['1', null, null, '0'],
    [null, null, null, '1'],
  ];
  const STATES = ['is-unify', 'is-when', 'is-reality', 'is-bit', 'is-we', 'is-byte', 'is-oct', 'is-back', 'is-link'];
  const LK = ['is-enter', 'is-drop', 'is-pbit', 'is-pbyte', 'is-unify', 'is-peak'];

  const wait = (ms: number, s: Sig) =>
    new Promise<void>((res, rej) => setTimeout(() => (s.stop ? rej(0) : res()), ms));

  function setup(root: HTMLElement) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const vis = q('.motto__vis');
    const sigEl = q('.motto__sig');
    const bit = q('[data-tok="bit"]');
    const byte = q('[data-tok="byte"]');
    const bites = q('[data-bites]');
    const afterBit = q('[data-after-bit]');
    const we = q('[data-before-byte]');
    const reality = q('.mw--reality');
    const bitCh = [...bit.querySelectorAll<HTMLElement>('.motto__ch')];
    const byteCh = [...byte.querySelectorAll<HTMLElement>('.motto__ch')];

    let run: Sig | null = null;
    let phase = 'idle';

    const paint = (chars: HTMLElement[], f: Frame | null) =>
      chars.forEach((c, i) => {
        const d = f ? f[i] : null;
        c.classList.toggle('is-d', !!d);
        if (d) c.dataset.d = d;
        else delete c.dataset.d;
      });

    const on = (...c: string[]) => root.classList.add(...c);
    const off = (...c: string[]) => root.classList.remove(...c);
    const lk = root.closest<HTMLElement>('[data-lockup]')!;
    const hasMark = !!lk.querySelector('.blk__mark');
    const lkOn = (c: string) => hasMark && lk.classList.add(c);
    const lkOff = (c: string) => lk.classList.remove(c);
    // Brief wordmark brightness pulse (ANGST observing the process).
    const pulse = (c: string, ms: number) => { lkOn(c); setTimeout(() => lkOff(c), ms); };
    // Phase A: ANGST rises from ~85% to resting brightness.
    const wake = () => {
      if (!hasMark) return;
      lk.classList.add('is-enter');
      void lk.offsetWidth;
      requestAnimationFrame(() => lkOff('is-enter'));
    };

    // ---- Stage zoom: one outer wrapper (.blk) is scaled; nothing inside changes size. ----
    const zoomEl = lk;
    const onStage = !!root.closest('[data-stage]');
    const EASE_IN = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const EASE_OUT = 'cubic-bezier(0.4, 0, 0.2, 1)';
    const curScale = () => {
      const t = getComputedStyle(zoomEl).transform;
      return t && t !== 'none' ? new DOMMatrixReadOnly(t).a : 1;
    };
    // Target from CSS (per viewport), clamped so the scaled lockup always keeps safe margins.
    const peak = (name: string) => {
      const want = parseFloat(getComputedStyle(zoomEl).getPropertyValue(name)) || 1;
      const sc = curScale();
      const r = zoomEl.getBoundingClientRect();
      const w = r.width / sc, h = r.height / sc;
      const stageEl = zoomEl.closest<HTMLElement>('[data-stage]');
      const sh = stageEl ? stageEl.clientHeight : innerHeight;
      const margin = Math.max(24, innerWidth * 0.03);
      const fitW = (innerWidth - margin * 2) / w;
      const fitH = (sh - 96) / h;
      return Math.max(1, Math.min(want, fitW, fitH));
    };
    const zoomTo = (scale: number, ms: number, easing: string) => {
      if (!onStage) return Promise.resolve();
      const from = curScale();
      zoomEl.getAnimations().forEach((a) => a.cancel());
      const a = zoomEl.animate([{ transform: `scale(${from})` }, { transform: `scale(${scale})` }], {
        duration: ms, easing, fill: 'forwards',
      });
      return a.finished.catch(() => undefined);
    };
    const zoomReset = () => zoomEl.getAnimations().forEach((a) => a.cancel());

    const reset = () => {
      paint(bitCh, null);
      paint(byteCh, null);
      off(...STATES);
      lk.classList.remove(...LK);
      zoomReset();
      sigEl.getAnimations().forEach((a) => a.cancel());
      sigEl.style.opacity = '0';
      delete sigEl.dataset.d;
      phase = 'idle';
    };

    const box = (el: HTMLElement) => {
      const o = vis.getBoundingClientRect();
      const rs = el.getClientRects();
      const a = rs[0] ?? el.getBoundingClientRect();
      const z = rs[rs.length - 1] ?? a;
      const k = 1 / curScale();
      return { l: (a.left - o.left) * k, r: (z.right - o.left) * k, t: (a.top - o.top) * k, b: (z.bottom - o.top) * k };
    };

    // 1px pulse from one token to another, following a line wrap if there is one.
    // lineEnd: element ending the source line; lineStart: element starting the target line.
    const travel = (from: HTMLElement, lineEnd: HTMLElement, lineStart: HTMLElement, to: HTMLElement, ms: number, digits?: string[]) => {
      const a = box(from), e = box(lineEnd), w = box(lineStart), y = box(to);
      const fs = parseFloat(getComputedStyle(root).fontSize);
      const h = fs > 64 ? 1.5 : 1; // hairline at every scale
      sigEl.style.height = `${h}px`;
      const ya = a.b - h * 2, yb = y.b - h * 2;
      const len = Math.max(14, fs * 0.3);
      const at = (x: number, yy: number, wd: number, op: number, offset?: number): Keyframe => ({
        transform: `translate(${x}px, ${yy}px)`, width: `${wd}px`, opacity: op, ...(offset !== undefined ? { offset } : {}),
      });
      const kf: Keyframe[] =
        Math.abs(a.t - y.t) < 4
          ? [at(a.l, ya, len, 0), at(a.l, ya, len, 0.75, 0.15), at(y.l - len, yb, len, 0.75, 0.85), at(y.l, yb, 0, 0)]
          : [
              at(a.l, ya, len, 0), at(a.l, ya, len, 0.75, 0.1), at(e.r - len, ya, len, 0.75, 0.45), at(e.r, ya, 0, 0, 0.5),
              at(w.l, yb, 0, 0, 0.52), at(w.l, yb, len, 0.75, 0.6), at(y.l - len, yb, len, 0.75, 0.92), at(y.l, yb, 0, 0),
            ];
      const anim = sigEl.animate(kf, { duration: ms, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' });
      // Optional tiny binary state riding on the pulse (BIT → BYTE only).
      if (digits?.length) {
        digits.forEach((d, i) => setTimeout(() => (sigEl.dataset.d = d), (ms / (digits.length + 1)) * (i + 0.5)));
        setTimeout(() => delete sigEl.dataset.d, ms * 0.92);
      }
      return anim.finished;
    };

    async function sequence(s: Sig, replay = false, entry = false) {
      try {
        let first = !replay;
        for (;;) {
          if (first && entry && onStage) {
            // Arrival: normal → zoom toward the viewer (ANGST 85% → full white) → settle → think.
            phase = 'entry';
            lkOn('is-enter');
            await wait(200, s);
            lkOff('is-enter');
            lkOn('is-peak');
            await zoomTo(peak('--zoom-entry'), 500, EASE_IN);
            if (s.stop) throw 0;
            await wait(250, s);
            lkOff('is-peak');
            await zoomTo(1, 550, EASE_OUT);
            if (s.stop) throw 0;
            await wait(250, s);
          } else if (first) {
            // Repeat loops: identity first, clean lockup until the sequence (no large zoom)
            phase = 'hold';
            wake();
            await wait(1350, s);
          }
          first = true;
          entry = false;
          phase = 'active';
          // Link ANGST → motto: 1px drop meets the start of the WHEN timeline (≈250ms)
          lkOn('is-drop');
          await wait(250, s);
          lkOff('is-drop');
          // WHEN — temporal: t₀ → t₁ (≈400ms)
          on('is-when');
          await wait(400, s);
          off('is-when');

          // REALITY — observed, partly uncertain (≈450ms) then pulse toward BITES (≈250ms)
          on('is-reality');
          await wait(450, s);
          off('is-reality');
          await travel(reality, reality, bites, bit, 250);
          if (s.stop) throw 0;

          // BIT — binary encoding inside "Bites" (≈700ms); ANGST registers it (80ms)
          on('is-bit');
          pulse('is-pbit', 80);
          for (const f of BIT_FRAMES) { paint(bitCh, f); await wait(120, s); }
          paint(bitCh, null);
          await wait(100, s);

          // WE — evidence converges, reasoning (≈400ms)
          on('is-we');
          await wait(400, s);
          off('is-we');

          // Signal BIT → BYTE with a riding 0 / 1 / 01 (≈400ms)
          await travel(bit, afterBit, we, byte, 400, ['0', '1', '01']);
          if (s.stop) throw 0;

          // BYTE — strongest binary transition + brief 8-cell structure (≈850ms); ANGST registers it (110ms)
          on('is-byte');
          pulse('is-pbyte', 110);
          // Second, much smaller zoom: the intelligence response (held through BACK and link)
          zoomTo(peak('--zoom-pulse'), 600, EASE_IN);
          for (let i = 0; i < BYTE_FRAMES.length; i++) {
            paint(byteCh, BYTE_FRAMES[i]);
            if (i === 4) on('is-oct');
            await wait(130, s);
          }
          paint(byteCh, null);
          off('is-oct');
          await wait(70, s);

          // BACK — response / reconstruction echo (≈550ms)
          on('is-back');
          await wait(550, s);
          off('is-back');

          // BIT + BYTE synchronised (≈500ms)
          on('is-link');
          paint(bitCh, [null, '1']);
          paint(byteCh, [null, null, null, '1']);
          await wait(170, s);
          paint(bitCh, null);
          paint(byteCh, null);
          await wait(330, s);

          // Unified lockup: ANGST + whole motto share one brightness (≈450ms)
          off(...STATES);
          lkOn('is-unify');
          on('is-unify');
          zoomTo(peak('--zoom-unify'), 350, EASE_IN);
          await wait(450, s);
          lkOff('is-unify');
          off('is-unify');
          await zoomTo(1, 700, EASE_OUT);
          if (s.stop) throw 0;
          // Clean static lockup — loop ≈ 10s (first loop ≈ 11.3s with the arrival zoom)
          phase = 'hold';
          await wait(2600, s);
        }
      } catch {
        /* stopped */
      }
    }

    const start = (replay = false, entry = false) => {
      if (run) run.stop = true;
      reset();
      run = { stop: false };
      sequence(run, replay, entry);
    };
    const stop = () => {
      if (run) run.stop = true;
      run = null;
      reset();
    };
    const inView = () => {
      const r = root.getBoundingClientRect();
      return r.top >= 0 && r.bottom <= window.innerHeight;
    };

    // Observe the full-screen stage when present. Start only when the stage is substantially
    // in view (≥55%); stop only when it has nearly left (<15%) so small scrolls never restart it.
    const stage = root.closest<HTMLElement>('[data-stage]');
    const target = stage ?? root;
    new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const r = e.intersectionRatio;
          // Arrival (after having substantially left) always plays the entry zoom once.
          if (r >= 0.55 && !run && !reduce.matches) start(false, true);
          else if (r < 0.15 && run) stop();
        }),
      { threshold: [0, 0.15, 0.55, 0.8] },
    ).observe(target);

    root.addEventListener('mouseenter', () => {
      if (run && phase === 'hold' && !reduce.matches && matchMedia('(hover: hover)').matches) start(true);
    });
    reduce.addEventListener('change', () => (reduce.matches ? stop() : inView() && start(false, true)));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) return stop();
      if (!run && !reduce.matches && inView()) start(false, true);
    });
    // Resizing mid-animation: return to normal scale and restart cleanly (debounced).
    let rz = 0;
    window.addEventListener('resize', () => {
      if (!run) return;
      clearTimeout(rz);
      rz = window.setTimeout(() => (inView() ? start(true) : stop()), 250);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-motto]').forEach(setup);
</script>
